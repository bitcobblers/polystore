{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/qwen#medium",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "deny",
    "bash": "allow",
    "task": "deny",
    "skill": "deny",
    "external_directory": "allow"
  },
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen": {
          "id": "qwen3.8-27b",
          "limit": {
            "context": 262144,
            "output": 49152
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  }
}
